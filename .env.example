APP_NAME=RAG API
APP_ENVIRONMENT=development
API_V1_PREFIX=/v1
OPENAI_API_KEY=replace-me

# Required in production. Replace placeholders through a secret manager.
DATABASE__URL=postgresql://user:password@localhost:5432/rag
DATABASE__POOL_MIN_SIZE=2
DATABASE__POOL_MAX_SIZE=10
DATABASE__POOL_TIMEOUT_SECONDS=10
DATABASE__CONNECT_TIMEOUT_SECONDS=5

STORAGE__ENDPOINT_URL=http://localhost:9000
STORAGE__REGION=us-east-1
STORAGE__BUCKET_NAME=rag-documents
STORAGE__KEY_PREFIX=rag
STORAGE__ACCESS_KEY_ID=replace-me
STORAGE__SECRET_ACCESS_KEY=replace-me
STORAGE__USE_TLS=false
STORAGE__SERVER_SIDE_ENCRYPTION=AES256
STORAGE__KMS_KEY_ID=
STORAGE__SIGNED_URL_TTL_SECONDS=900

BROKER__URL=amqp://user:password@localhost:5672/rag
BROKER__USE_TLS=false
BROKER__TLS_CA_CERT_PATH=
BROKER__TLS_CERT_PATH=
BROKER__TLS_KEY_PATH=
BROKER__VISIBILITY_TIMEOUT_SECONDS=3600
BROKER__PREFETCH_MULTIPLIER=1
BROKER__MESSAGE_MAX_BYTES=65536
BROKER__HEARTBEAT_SECONDS=30
BROKER__CONNECTION_MAX_RETRIES=5
BROKER__CONNECTION_TIMEOUT_SECONDS=5
BROKER__NATIVE_QUEUE_NAME=ingestion.native
BROKER__OCR_QUEUE_NAME=ingestion.ocr

WORKERS__NATIVE_CONCURRENCY=2
WORKERS__OCR_CONCURRENCY=1
WORKERS__NATIVE_PARSE_TIMEOUT_SECONDS=300
WORKERS__OCR_TIMEOUT_SECONDS=900
WORKERS__NATIVE_PARSE_MEMORY_MIB=2048
WORKERS__OCR_MEMORY_MIB=512
WORKERS__NATIVE_CPU_LIMIT=2.0
WORKERS__OCR_CPU_LIMIT=1.0
WORKERS__JOB_TEMP_DIRECTORY=/var/lib/rag-jobs
WORKERS__SHUTDOWN_GRACE_SECONDS=30
WORKERS__JOB_MAX_ATTEMPTS=3
WORKERS__RETRY_BASE_SECONDS=30
WORKERS__RETRY_MAX_SECONDS=900

INGESTION__ALLOWED_MIME_TYPES='["application/pdf"]'
INGESTION__UPLOAD_MAX_BYTES=104857600
INGESTION__PDF_MAX_PAGES=500
INGESTION__PDF_ALLOW_EMBEDDED_FILES=false
INGESTION__PDF_MAX_CONTENT_STREAM_BYTES_PER_PAGE=16777216
INGESTION__NORMALIZED_MAX_BYTES=268435456
INGESTION__EXTRACTED_TEXT_MAX_CHARS=20000000
INGESTION__MAX_CHUNKS=10000
INGESTION__QUEUE_AGE_ALERT_SECONDS=900
INGESTION__OCR_LANGUAGE_CODES='["eng"]'
INGESTION__OCR_MIN_CONFIDENCE=0.70

TELEMETRY__SERVICE_NAME=rag-api
TELEMETRY__LOG_LEVEL=INFO
TELEMETRY__OTLP_ENDPOINT=
TELEMETRY__TRACES_ENABLED=false
TELEMETRY__METRICS_ENABLED=true

PROVIDER_TIMEOUTS__CONNECT_SECONDS=5
PROVIDER_TIMEOUTS__REQUEST_SECONDS=30
PROVIDER_TIMEOUTS__EMBEDDING_SECONDS=60
PROVIDER_TIMEOUTS__STORAGE_SECONDS=30
