APP_NAME=RAG API
APP_ENVIRONMENT=development
RUNTIME_ROLE=api
API_V1_PREFIX=/v1
API_REQUEST_MAX_BYTES=65536
OPENAI_API_KEY=replace-me

# Required in production for OIDC bearer-token validation.
AUTH__ISSUER=https://identity.example.com/
AUTH__AUDIENCE=rag-api
AUTH__JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH__TENANT_CLAIM=tenant_id
AUTH__JWKS_CACHE_TTL_SECONDS=300

# Required in production. Replace placeholders through a secret manager.
DATABASE__URL=postgresql://user:password@localhost:5432/rag
DATABASE__POOL_MIN_SIZE=2
DATABASE__POOL_MAX_SIZE=10
DATABASE__POOL_TIMEOUT_SECONDS=10
DATABASE__CONNECT_TIMEOUT_SECONDS=5

STORAGE__ENDPOINT_URL=http://localhost:9000
STORAGE__REGION=us-east-1
STORAGE__BUCKET_NAME=rag-documents
STORAGE__KEY_PREFIX=rag
STORAGE__ACCESS_KEY_ID=replace-me
STORAGE__SECRET_ACCESS_KEY=replace-me
STORAGE__USE_TLS=false
STORAGE__SERVER_SIDE_ENCRYPTION=AES256
STORAGE__KMS_KEY_ID=
STORAGE__SIGNED_URL_TTL_SECONDS=900

BROKER__URL=amqp://user:password@localhost:5672/rag
BROKER__USE_TLS=false
BROKER__TLS_CA_CERT_PATH=
BROKER__TLS_CERT_PATH=
BROKER__TLS_KEY_PATH=
BROKER__PREFETCH_MULTIPLIER=1
BROKER__MESSAGE_MAX_BYTES=65536
BROKER__QUEUE_MAX_MESSAGES=10000
BROKER__QUEUE_MAX_BYTES=268435456
BROKER__QUEUE_MESSAGE_TTL_SECONDS=86400
BROKER__HEARTBEAT_SECONDS=30
BROKER__CONNECTION_MAX_RETRIES=5
BROKER__CONNECTION_TIMEOUT_SECONDS=5
BROKER__NATIVE_QUEUE_NAME=ingestion.native
BROKER__OCR_QUEUE_NAME=ingestion.ocr
BROKER__PUBLICATION_QUEUE_NAME=ingestion.publication
BROKER__LIFECYCLE_QUEUE_NAME=ingestion.lifecycle
BROKER__DEAD_LETTER_EXCHANGE_NAME=ingestion.dead-letter.exchange
BROKER__DEAD_LETTER_QUEUE_NAME=ingestion.dead-letter

WORKERS__NATIVE_CONCURRENCY=2
WORKERS__OCR_CONCURRENCY=1
WORKERS__PUBLICATION_CONCURRENCY=1
WORKERS__LIFECYCLE_CONCURRENCY=1
WORKERS__NATIVE_PARSE_TIMEOUT_SECONDS=300
WORKERS__OCR_TIMEOUT_SECONDS=900
WORKERS__PUBLICATION_TIMEOUT_SECONDS=900
WORKERS__LIFECYCLE_TIMEOUT_SECONDS=300
WORKERS__NATIVE_PARSE_MEMORY_MIB=2048
WORKERS__OCR_MEMORY_MIB=512
WORKERS__PUBLICATION_MEMORY_MIB=1024
WORKERS__LIFECYCLE_MEMORY_MIB=512
WORKERS__NATIVE_CPU_LIMIT=2.0
WORKERS__OCR_CPU_LIMIT=1.0
WORKERS__PUBLICATION_CPU_LIMIT=2.0
WORKERS__LIFECYCLE_CPU_LIMIT=1.0
WORKERS__JOB_TEMP_DIRECTORY=/var/lib/rag-jobs
WORKERS__SHUTDOWN_GRACE_SECONDS=30
WORKERS__JOB_MAX_ATTEMPTS=3
WORKERS__MAX_TASKS_PER_CHILD=25
WORKERS__RETRY_BASE_SECONDS=30
WORKERS__RETRY_MAX_SECONDS=900

INGESTION__ALLOWED_MIME_TYPES='["application/pdf"]'
INGESTION__UPLOAD_MAX_BYTES=104857600
INGESTION__PDF_MAX_PAGES=500
INGESTION__PDF_ALLOW_EMBEDDED_FILES=false
INGESTION__PDF_MAX_CONTENT_STREAM_BYTES_PER_PAGE=16777216
INGESTION__NORMALIZED_MAX_BYTES=268435456
INGESTION__EXTRACTED_TEXT_MAX_CHARS=20000000
INGESTION__NATIVE_MIN_TEXT_CHARS_PER_PAGE=20
INGESTION__NATIVE_MAX_BLOCKS_PER_PAGE=10000
INGESTION__MAX_CHUNKS=10000
INGESTION__CHUNK_MAX_TOKENS=96
INGESTION__CHUNK_OVERLAP_TOKENS=16
INGESTION__CHUNK_PAGE_MAX_CHARS=2000000
INGESTION__QUEUE_AGE_ALERT_SECONDS=900
INGESTION__OCR_LANGUAGE_CODES='["eng"]'
INGESTION__OCR_MIN_CONFIDENCE=0.70
INGESTION__OCR_RENDER_DPI=300
INGESTION__OCR_PAGE_TIMEOUT_SECONDS=120
INGESTION__OCR_MAX_RENDERED_PAGE_BYTES=67108864

EMBEDDING__PROVIDER=fastembed
EMBEDDING__MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING__MODEL_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
EMBEDDING__MODEL_VERSION=faf4aa4225822f3bc6376869cb1164e8e3feedd0-fastembed-0.8.0-mean
EMBEDDING__MODEL_DIRECTORY=/opt/rag/models/multilingual-minilm
EMBEDDING__MODEL_SHA256=634d0f66c29dc934c8fa72b8a4fe91dd4d420a22f1d82a241058d4316e659a99
EMBEDDING__DIMENSIONS=384
EMBEDDING__BATCH_SIZE=16
EMBEDDING__MAX_CONCURRENT_BATCHES=1

SEARCH__ENDPOINT_URL=https://localhost:9200
SEARCH__USERNAME=admin
SEARCH__PASSWORD=replace-me
SEARCH__INDEX_NAME=rag-chunks-v1
SEARCH__TARGET_VERSION=opensearch-2.19.5-hybrid-v1
SEARCH__VERIFY_TLS=true
SEARCH__REQUEST_TIMEOUT_SECONDS=30
LIFECYCLE__DELETE_BATCH_SIZE=250
LIFECYCLE__RECONCILE_PAGE_SIZE=200
LIFECYCLE__STALE_JOB_SECONDS=900
LIFECYCLE__RECONCILE_INTERVAL_SECONDS=60

TELEMETRY__SERVICE_NAME=rag-api
TELEMETRY__LOG_LEVEL=INFO
TELEMETRY__OTLP_ENDPOINT=
TELEMETRY__TRACES_ENABLED=false
TELEMETRY__METRICS_ENABLED=true
TELEMETRY__METRICS_BEARER_TOKEN=
TELEMETRY__METRICS_CACHE_TTL_SECONDS=15
TELEMETRY__METRICS_QUERY_TIMEOUT_SECONDS=2

READINESS__CACHE_TTL_SECONDS=5
READINESS__SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180

# Atlas Harness stays disabled and local-only by default. For Unix mode, place
# the socket inside STATE_DIRECTORY and pre-create its parent with mode 0700.
HARNESS__ENABLED=false
HARNESS__WORKSPACE_ROOT=
HARNESS__STATE_DIRECTORY=
HARNESS__ISOLATION_EXECUTABLE=
HARNESS__LOCAL_TRANSPORT=stdio
HARNESS__UNIX_SOCKET_PATH=
HARNESS__LOOPBACK_HTTP_ENABLED=false
HARNESS__ACTIVE_SESSIONS=8
HARNESS__QUEUED_SESSIONS=64
HARNESS__SUBSCRIBER_QUEUE_EVENTS=256
HARNESS__REQUEST_MAX_BYTES=1048576
HARNESS__REQUEST_TIMEOUT_SECONDS=30
HARNESS__HANDSHAKE_TIMEOUT_SECONDS=5
HARNESS__SHUTDOWN_TIMEOUT_SECONDS=5
HARNESS__TOOL_NETWORK_ENABLED=false
HARNESS__TELEMETRY_EXPORT_ENABLED=false

PROVIDER_TIMEOUTS__CONNECT_SECONDS=5
PROVIDER_TIMEOUTS__REQUEST_SECONDS=30
PROVIDER_TIMEOUTS__EMBEDDING_SECONDS=60
PROVIDER_TIMEOUTS__STORAGE_SECONDS=30
